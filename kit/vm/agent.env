# /etc/agent-kit/agent.env  (systemd EnvironmentFile for agent processes)
HTTP_PROXY=http://10.66.0.1:3128
HTTPS_PROXY=http://10.66.0.1:3128
http_proxy=http://10.66.0.1:3128
https_proxy=http://10.66.0.1:3128
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1
PATH=/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Built-in subagents (Explore etc.) and any definition without a model.
CLAUDE_CODE_SUBAGENT_MODEL=sonnet
# Env scrub needs bubblewrap + unprivileged user namespaces, which Ubuntu 24.04
# blocks via AppArmor. Off: the login is a file the agent user can read anyway,
# so scrubbing env vars adds nothing; the VM boundary is the protection.
CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=0
# Headless cycles must not leave background work behind (see lead-cycle.md).
CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
