#!/bin/bash
# agent-kit-gate: pause or resume the merge gate on its own, without halting
# the team, and decide on changes the gate held for the owner. Run with sudo.
# While paused, submitted branches wait; a check already running is allowed to
# finish.
#
#   agent-kit-gate pause [reason words] | resume | show
#   agent-kit-gate held                  held changes, one JSON line each (kit 0.14)
#   agent-kit-gate approve <sha>         the gate judges it again and merges it if it passes
#   agent-kit-gate deny <sha>            the verdict becomes `failed`
#
# A change is held when it touches a path in GATE_OWNER_PATHS (project.env):
# what "done" means is the owner's to decide (see gate-run).
set -uo pipefail
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
# shellcheck source=/dev/null
source "$ETC/project.env"
PATH=${AGENT_KIT_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}
export PATH
F=$STATE/gate/paused
RES=$STATE/gate/results
APPROVED=$STATE/gate/approved

die() { echo "agent-kit-gate: $*" >&2; exit 2; }
# The result file that holds <sha> for the owner, or nothing.
held_file() {
  local f
  for f in "$RES"/*.json; do
    [ -f "$f" ] || continue
    [ "$(jq -r '.status + " " + .sha' "$f" 2>/dev/null)" = "held $1" ] && { echo "$f"; return 0; }
  done
  return 1
}

case "${1:-show}" in
  pause)
    shift
    printf '%s %s\n' "$(date -Is)" "$(printf '%s' "${*:-by owner}" | tr -c 'A-Za-z0-9 .,:()_/@-' ' ' | cut -c1-160)" > "$F"
    chmod 644 "$F"
    echo "gate paused"
    ;;
  resume)
    rm -f "$F"
    echo "gate running"
    ;;
  show)
    if [ -f "$F" ]; then echo "gate paused: $(cat "$F")"; else echo "gate running"; fi
    ;;
  held)
    for f in "$RES"/*.json; do
      [ -f "$f" ] || continue
      jq -c 'select(.status == "held") | {topic, sha, at, detail}' "$f" 2>/dev/null
    done | head -50
    ;;
  approve|deny)
    sha=${2:-}
    [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "usage: agent-kit-gate $1 <sha (40 hex)>"
    f=$(held_file "$sha") || die "nothing is held for the owner at $sha"
    if [ "$1" = approve ]; then
      mkdir -p "$APPROVED" && chmod 755 "$APPROVED"
      date -Is > "$APPROVED/$sha" && chmod 644 "$APPROVED/$sha"
      # Judge it now rather than at the next timer tick (no effect while the team is halted).
      systemctl start --no-block agent-kit-gate.service 2>/dev/null || true
      echo "approved: the gate judges ${sha:0:9} again and merges it if it still passes"
    else
      topic=$(jq -r .topic "$f")
      tmp=$(mktemp "$RES/.deny.XXXXXX")
      jq --arg at "$(date -Is)" '.status = "failed" | .detail = "the owner declined this change to what done means" | .at = $at' "$f" > "$tmp" \
        && chmod 644 "$tmp" && mv "$tmp" "$f"
      echo "$(date -Is) $topic $sha failed the owner declined this change to what done means" >> "$STATE/gate/history.log"
      echo "declined: ${sha:0:9} will not be merged"
    fi
    ;;
  *)
    echo "usage: agent-kit-gate pause [reason] | resume | show | held | approve <sha> | deny <sha>" >&2
    exit 2
    ;;
esac
