#!/bin/bash
# owner-publish: how the lead asks for main to be published to the project's
# remote repository. Runs as `agent`. Root-owned, like everything in /opt/agent-kit.
#
#   owner-publish request [no]   ask the owner's console to publish main (a short summary on
#                                stdin); `no` withdraws the request
#   owner-publish status         what is published, and whether a request waits
#   owner-publish prompt         the protocol (added to the lead's prompt while publishing is set up)
#
# Nobody in this VM can push: there is no key here and the remote is not
# reachable. The console fetches main, checks it and pushes it. See agent-kit-publish.
#
# Layout:
#   $STATE/publish/enabled, last, blocked   root-owned: written for the console
#   $STATE/publish-out/request.md           the lead's request (agent-written)
set -uo pipefail
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
# shellcheck source=/dev/null
source "$ETC/project.env"
PUB=$STATE/publish
OUT=$STATE/publish-out
SHA_RE='^[0-9a-f]{40}$'

die() { echo "owner-publish: $*" >&2; exit 2; }
header() { sed -n "1,/^---\$/s/^$2: //p" "$1" 2>/dev/null | head -1; }
enabled() { [ -s "$PUB/enabled" ]; }

# What is published, in words.
state() {
  local sha="" at="" main ahead
  [ -f "$PUB/last" ] && read -r sha at < "$PUB/last"
  if [[ $sha =~ $SHA_RE ]]; then
    main=$(git -C "$BARE" rev-parse -q --verify refs/heads/main 2>/dev/null)
    ahead=$(git -C "$BARE" rev-list --count "$sha..$main" 2>/dev/null)
    echo "Last published: ${sha:0:9} on $at. main is ${ahead:-?} commit(s) ahead of that."
  else
    echo "Nothing has been published yet."
  fi
  if [ -f "$PUB/blocked" ]; then
    echo "The last attempt was REFUSED by the console's checks ($(head -1 "$PUB/blocked")):"
    sed -n '2,9p' "$PUB/blocked" | sed 's/^/  /'
  fi
  if [ -f "$OUT/request.md" ]; then
    echo "Your request: Publish: $(header "$OUT/request.md" Publish), written $(header "$OUT/request.md" Date)."
  else
    echo "You have not asked for a publish."
  fi
}

case "${1:-status}" in
  request)
    want=yes
    case "${2:-}" in
      "") ;;
      no) want=no ;;
      *) die "usage: owner-publish request [no]   (summary on stdin)" ;;
    esac
    enabled || die "publishing is not set up for this project"
    mkdir -p "$OUT" || die "could not write the request"
    tmp=$OUT/.request.tmp
    {
      printf 'Publish: %s\nDate: %s\n---\n' "$want" "$(date -u +%FT%TZ)"
      head -c 4000
    } > "$tmp" || die "could not write the request"
    mv "$tmp" "$OUT/request.md"
    if [ "$want" = yes ]; then
      echo "asked: the console publishes main once the gate has judged what this cycle submitted"
    else
      echo "withdrawn: nothing is published until you ask again"
    fi
    ;;

  status)
    enabled || { echo "Publishing is not set up for this project."; exit 0; }
    echo "Remote: $(head -1 "$PUB/enabled")"
    state
    ;;

  prompt)
    # Printed at the end of the lead's prompt every cycle, only while publishing
    # is set up. Keep the wording neutral: team themes rename roles.
    enabled || exit 0
    cat <<PROMPT
## Publishing

This project's \`main\` is published to a remote repository: \`$(head -1 "$PUB/enabled")\`.

You cannot push, and neither can your agents: this machine holds no key and cannot reach the remote.
Do not look for a way. The owner's console copies the gate's \`main\` there when you ask, after its own
checks. Only what the gate has merged is ever published, with the same commits.

- At the end of a cycle whose work should go out, run \`owner-publish request\` with a short summary
  on stdin: what changed, written for a reader outside the team. One request covers everything on
  \`main\` at that time. \`owner-publish request no\` withdraws it.
- Everything that is published can be read by anyone. Never commit secrets, tokens, keys, private
  addresses or anything personal: the console scans what is new and refuses the whole publish if it
  finds one. A refused publish stays refused until \`main\` no longer adds it.
- Changes to CI files (\`.github/workflows/\`, \`.gitea/workflows/\`, \`.gitlab-ci.yml\`,
  \`azure-pipelines.yml\`) are refused too. If the project needs one, ask the owner (\`owner-inbox ask\`).
- Nothing comes back from the remote. Issues and reviews stay here.
- Only you, the lead, ask for a publish; your agents do not.

$(state)
PROMPT
    ;;

  *)
    die "unknown command: $1 (request, status, prompt)"
    ;;
esac
