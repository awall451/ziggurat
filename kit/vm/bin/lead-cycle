#!/bin/bash
# lead-cycle: one headless lead cycle. Runs as `agent` from agent-kit-lead.service.
# Root-owned; config in /etc/agent-kit/project.env, owner's changes in caps.env.
set -uo pipefail
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
KIT=${AGENT_KIT_HOME:-/opt/agent-kit}
# shellcheck source=/dev/null
source "$ETC/project.env"
# Brakes and models changed by the owner (agent-kit-caps) win over the defaults.
# shellcheck source=/dev/null
[ -f "$ETC/caps.env" ] && source "$ETC/caps.env"
LEDGER=$STATE/ledger/cycles.jsonl
mkdir -p "$STATE/ledger/runs"

if grep -q '^stop' "$STATE/control" 2>/dev/null; then echo "control=stop: not running"; exit 0; fi
# A scheduled stop whose time has come: do not start (agent-kit-tick does the halt).
if [ -f "$STATE/halt-at" ]; then
  read -r due _ < "$STATE/halt-at"
  if [[ ${due:-} =~ ^[0-9]+$ ]] && [ "$(date +%s)" -ge "$due" ]; then echo "scheduled stop time has passed: not running"; exit 0; fi
fi
# A halt asked for "after this cycle" (agent-kit-halt-after) waits for the gate
# once the cycle is over, which can take longer than the timer does: no new
# cycle may start in between.
if [ -f "$STATE/halt-after" ]; then echo "a halt after the last cycle is pending: not running"; exit 0; fi

# A one-shot job (agent-kit-oneshot): this cycle works on one owner message and
# the team halts again when it ends. The marker and the control line are both
# root-owned and must agree, so a stale marker cannot change a normal cycle.
# A planning cycle (kit 0.10) is the same kind of start with a -p- id: its
# request is in the backlog folder, not in the inbox.
oneshot= plan= kind=normal
if [ -f "$STATE/oneshot" ]; then
  read -r oneshot _ < "$STATE/oneshot"
  if [[ ${oneshot:-} =~ ^[0-9]{8}T[0-9]{6}Z-p-[a-z0-9-]{1,40}$ ]]; then
    { grep -q "^run oneshot $oneshot " "$STATE/control" 2>/dev/null \
      && [ -f "$STATE/backlog/plans/$oneshot/request.md" ]; } && plan=$oneshot
    oneshot=$plan
  else
    { [[ ${oneshot:-} =~ ^[0-9]{8}T[0-9]{6}Z-o-[a-z0-9-]{1,40}$ ]] && grep -q "^run oneshot $oneshot " "$STATE/control" 2>/dev/null \
      && [ -f "$STATE/inbox/$oneshot/message.md" ]; } || oneshot=
  fi
fi
if [ -n "$plan" ]; then kind=plan; elif [ -n "$oneshot" ]; then kind=oneshot; fi

# A schedule (agent-kit-schedule): a normal cycle starts only at one of its
# slots. The tick leaves a root-owned marker just before it starts this unit;
# without a fresh one this start came from the lead timer, and there is
# nothing to do. A one-shot job is the owner asking for this cycle: it runs.
slot=
if [ -z "$oneshot" ] && grep -q '^slot ' "$ETC/schedule" 2>/dev/null; then
  if [ -f "$STATE/slot" ]; then
    read -r slot slot_at _ < "$STATE/slot"
    { [[ ${slot:-} =~ ^[a-z,]{3,27}@[0-9]{2}:[0-9]{2}$ ]] && [[ ${slot_at:-} =~ ^[0-9]{9,11}$ ]] \
      && [ $(($(date +%s) - slot_at)) -le 300 ] && [ $(($(date +%s) - slot_at)) -ge -60 ] \
      && [ "$(cat "$STATE/ledger/slot-used" 2>/dev/null)" != "$slot $slot_at" ]; } || slot=
  fi
  if [ -z "$slot" ]; then echo "a schedule is set: waiting for the next slot"; exit 0; fi
  # One marker, one cycle.
  echo "$slot $slot_at" > "$STATE/ledger/slot-used"
fi

today=$(date +%F)
# Only real work counts toward the daily cap: attempts that hit a usage limit
# (counted:false) must not use it up while waiting for the window to reset.
n_today=$(jq -s --arg d "$today" '[.[] | select(.date == $d and .counted != false)] | length' "$LEDGER" 2>/dev/null)
n_today=${n_today:-0}
# The daily cap is a brake on unattended cycles. A one-shot job is the owner
# asking for this cycle, so it runs even when the cap is used up (it still counts).
if [ -z "$oneshot" ] && [ "$n_today" -ge "$MAX_CYCLES_PER_DAY" ]; then
  echo "daily cycle cap reached ($n_today/$MAX_CYCLES_PER_DAY)"; exit 0
fi

cd "$WORKSPACE" || exit 1
# What a planning cycle may use (kit 0.10): no Edit, Write, agents or
# scheduling tools. The shell stays, for owner-backlog; a change to the
# workspace anyway is recorded in the ledger (touched_code) for the owner.
PLAN_TOOLS="Read,Grep,Glob,Bash"
workspace_print() { { git rev-parse HEAD 2>/dev/null; git status --porcelain 2>/dev/null; git worktree list --porcelain 2>/dev/null; git branch --list 2>/dev/null; } | sha256sum | cut -c1-16; }
git fetch -q gate 2>/dev/null || true
start=$(date -Is); t0=$SECONDS
run=$STATE/ledger/runs/$(date +%Y%m%dT%H%M%S)

# This cycle's session id is fixed up front: the owner-inbox hook uses it to
# tell the lead's session from any other Claude run on this machine, and the
# console uses `current` to find the cycle in progress.
sid=$(cat /proc/sys/kernel/random/uuid)
export ZIGGURAT_LEAD_SESSION=$sid
printf '%s %s\n' "$sid" "$start" > "$STATE/ledger/current"

# The prompt is the team's lead-cycle.md plus the owner-inbox protocol and any
# open owner messages, then the owner-issues protocol and any open issues.
prompt=$(cat "$KIT/lead-cycle.md")
if [ -x "$KIT/bin/owner-inbox" ]; then
  inbox=$("$KIT/bin/owner-inbox" prompt 2>/dev/null) && [ -n "$inbox" ] && prompt+=$'\n\n'"$inbox"
fi
if [ -x "$KIT/bin/owner-issues" ]; then
  issues=$("$KIT/bin/owner-issues" prompt 2>/dev/null) && [ -n "$issues" ] && prompt+=$'\n\n'"$issues"
fi
# Publishing to a remote repository: prints nothing unless it is set up.
if [ -x "$KIT/bin/owner-publish" ]; then
  publish=$("$KIT/bin/owner-publish" prompt 2>/dev/null) && [ -n "$publish" ] && prompt+=$'\n\n'"$publish"
fi
if [ -x "$KIT/bin/owner-backlog" ]; then
  backlog=$("$KIT/bin/owner-backlog" prompt 2>/dev/null) && [ -n "$backlog" ] && prompt+=$'\n\n'"$backlog"
fi
# Changes to the gate's checks wait for the owner (kit 0.14): nothing unless the project has owner paths.
if [ -x "$KIT/bin/owner-gate" ]; then
  gateown=$("$KIT/bin/owner-gate" prompt 2>/dev/null) && [ -n "$gateown" ] && prompt+=$'\n\n'"$gateown"
fi
# System packages and domains: the lead asks, the owner approves (kit 0.16).
if [ -x "$KIT/bin/owner-packages" ]; then
  pkgs=$("$KIT/bin/owner-packages" prompt 2>/dev/null) && [ -n "$pkgs" ] && prompt+=$'\n\n'"$pkgs"
fi
budget=$CYCLE_BUDGET_USD
tools=()
if [ -n "$plan" ]; then
  # A planning cycle writes proposals, not code: the file-writing tools and
  # agents are not there at all, and the budget is the small planning one.
  head=$("$KIT/bin/owner-backlog" plan "$plan" --head 2>/dev/null)
  job=$("$KIT/bin/owner-backlog" plan "$plan" 2>/dev/null)
  if [ -z "$head" ] || [ -z "$job" ]; then
    rm -f "$STATE/ledger/current"
    echo "planning cycle $plan: could not build its prompt: not running"; exit 1
  fi
  prompt=$head$'\n\n'$prompt$'\n\n'$job
  budget=${PLAN_BUDGET_USD:-2}
  tools=(--tools "$PLAN_TOOLS")
  mkdir -p "$STATE/ledger/plans"
  printf '%s\n' "$sid" > "$STATE/ledger/plans/$plan"
elif [ -n "$oneshot" ]; then
  # The job and its rules go last, and a notice that this is a one-shot cycle
  # goes before the team's own instructions, which say the opposite in places.
  # Without them this would be a normal cycle the owner did not ask for.
  head=$("$KIT/bin/owner-inbox" oneshot "$oneshot" --head 2>/dev/null)
  job=$("$KIT/bin/owner-inbox" oneshot "$oneshot" 2>/dev/null)
  if [ -z "$head" ] || [ -z "$job" ]; then
    rm -f "$STATE/ledger/current"
    echo "one-shot job $oneshot: could not build its prompt: not running"; exit 1
  fi
  prompt=$head$'\n\n'$prompt$'\n\n'$job
fi
settings=()
[ -f "$KIT/lead-settings.json" ] && settings=(--settings "$KIT/lead-settings.json")

export CLAUDE_CODE_RETRY_WATCHDOG=1
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
# On a halt systemd stops the whole service. Catch the signal here so the
# ledger line below is still written for the interrupted cycle.
halted=false
trap 'halted=true' TERM
before=""
[ "$kind" = plan ] && before=$(workspace_print)
claude -p "$prompt" \
  --session-id "$sid" "${settings[@]}" "${tools[@]}" \
  --model "$LEAD_MODEL" --fallback-model "$FALLBACK_MODEL" \
  --dangerously-skip-permissions \
  --max-budget-usd "$budget" \
  --output-format json > "$run.json" 2> "$run.err"
rc=$?
rm -f "$STATE/ledger/current"
touched=false
[ "$kind" = plan ] && [ "$(workspace_print)" != "$before" ] && touched=true
# Usage-limit hit? (session/weekly limit, rate limit). Then this attempt is
# not counted and the timer simply retries later; after the reset the next
# attempt runs normally. No human needed.
limited=false
if grep -qiE "usage limit|session limit|weekly limit|limit reached|hit your .*limit|rate.?limit|resets at|429" "$run.json" "$run.err" 2>/dev/null \
   && [ "$(jq -r '.num_turns // 0' "$run.json" 2>/dev/null || echo 0)" -le 2 ]; then
  limited=true
fi
# A cycle that was stopped leaves an empty result file. jq prints nothing for
# an empty file and still exits 0, so check for content first: otherwise a
# halted cycle would get no ledger line at all.
if ! { [ -s "$run.json" ] && jq -e -c --arg date "$today" --arg start "$start" --arg end "$(date -Is)" --arg sid "$sid" --arg oneshot "$oneshot" --arg slot "$slot" --arg kind "$kind" --arg plan "$plan" --argjson touched $touched \
      --argjson secs $((SECONDS - t0)) --argjson rc $rc --argjson limited $limited --argjson halted $halted \
  '{date:$date, start:$start, end:$end, secs:$secs, rc:$rc, limited:$limited, counted:($limited | not), halted:$halted,
    oneshot:(if $oneshot == "" then null else $oneshot end),
    slot:(if $slot == "" then null else $slot end),
    kind:$kind, plan:(if $plan == "" then null else $plan end), touched_code:$touched,
    cost_usd:(.total_cost_usd // null), turns:(.num_turns // null),
    session:(.session_id // $sid), is_error:(.is_error // null),
    summary:((.result // "") | tostring | .[-600:])}' "$run.json" >> "$LEDGER" 2>/dev/null; }; then
  jq -nc --arg date "$today" --arg start "$start" --arg end "$(date -Is)" --arg sid "$sid" --arg oneshot "$oneshot" --arg slot "$slot" --arg kind "$kind" --arg plan "$plan" --argjson touched $touched --argjson rc $rc \
     --argjson secs $((SECONDS - t0)) --argjson limited $limited --argjson halted $halted --arg err "$(tail -c 600 "$run.err")" \
     '{date:$date, start:$start, end:$end, secs:$secs, rc:$rc, limited:$limited, counted:($limited | not), halted:$halted,
       oneshot:(if $oneshot == "" then null else $oneshot end),
    slot:(if $slot == "" then null else $slot end), kind:$kind, plan:(if $plan == "" then null else $plan end),
    touched_code:$touched, session:$sid, summary:((if $halted then "halted by the owner mid-cycle. " else "no json output: " end) + $err)}' >> "$LEDGER"
fi
echo "cycle done rc=$rc limited=$limited halted=$halted oneshot=${oneshot:-no} in $((SECONDS - t0))s"
exit 0
