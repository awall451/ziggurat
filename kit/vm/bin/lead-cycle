#!/bin/bash
# lead-cycle: one headless lead cycle. Runs as `agent` from agent-kit-lead.service.
# Root-owned; config in /etc/agent-kit/project.env, owner's changes in caps.env.
set -uo pipefail
source /etc/agent-kit/project.env
# Brakes and models changed by the owner (agent-kit-caps) win over the defaults.
# shellcheck source=/dev/null
[ -f /etc/agent-kit/caps.env ] && source /etc/agent-kit/caps.env
LEDGER=$STATE/ledger/cycles.jsonl
mkdir -p "$STATE/ledger/runs"

if grep -q '^stop' "$STATE/control" 2>/dev/null; then echo "control=stop: not running"; exit 0; fi
# A scheduled stop whose time has come: do not start (agent-kit-tick does the halt).
if [ -f "$STATE/halt-at" ]; then
  read -r due _ < "$STATE/halt-at"
  if [[ ${due:-} =~ ^[0-9]+$ ]] && [ "$(date +%s)" -ge "$due" ]; then echo "scheduled stop time has passed: not running"; exit 0; fi
fi

today=$(date +%F)
# Only real work counts toward the daily cap: attempts that hit a usage limit
# (counted:false) must not use it up while waiting for the window to reset.
n_today=$(jq -s --arg d "$today" '[.[] | select(.date == $d and .counted != false)] | length' "$LEDGER" 2>/dev/null)
n_today=${n_today:-0}
if [ "$n_today" -ge "$MAX_CYCLES_PER_DAY" ]; then
  echo "daily cycle cap reached ($n_today/$MAX_CYCLES_PER_DAY)"; exit 0
fi

cd "$WORKSPACE" || exit 1
git fetch -q gate 2>/dev/null || true
start=$(date -Is); t0=$SECONDS
run=$STATE/ledger/runs/$(date +%Y%m%dT%H%M%S)

# This cycle's session id is fixed up front: the owner-inbox hook uses it to
# tell the lead's session from any other Claude run on this machine, and the
# console uses `current` to find the cycle in progress.
sid=$(cat /proc/sys/kernel/random/uuid)
export ZIGGURAT_LEAD_SESSION=$sid
printf '%s %s\n' "$sid" "$start" > "$STATE/ledger/current"

# The prompt is the team's lead-cycle.md plus the owner-inbox protocol and any
# open owner messages, then the owner-issues protocol and any open issues.
prompt=$(cat /opt/agent-kit/lead-cycle.md)
if [ -x /opt/agent-kit/bin/owner-inbox ]; then
  inbox=$(/opt/agent-kit/bin/owner-inbox prompt 2>/dev/null) && [ -n "$inbox" ] && prompt+=$'\n\n'"$inbox"
fi
if [ -x /opt/agent-kit/bin/owner-issues ]; then
  issues=$(/opt/agent-kit/bin/owner-issues prompt 2>/dev/null) && [ -n "$issues" ] && prompt+=$'\n\n'"$issues"
fi
settings=()
[ -f /opt/agent-kit/lead-settings.json ] && settings=(--settings /opt/agent-kit/lead-settings.json)

export CLAUDE_CODE_RETRY_WATCHDOG=1
unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN
# On a halt systemd stops the whole service. Catch the signal here so the
# ledger line below is still written for the interrupted cycle.
halted=false
trap 'halted=true' TERM
claude -p "$prompt" \
  --session-id "$sid" "${settings[@]}" \
  --model "$LEAD_MODEL" --fallback-model "$FALLBACK_MODEL" \
  --dangerously-skip-permissions \
  --max-budget-usd "$CYCLE_BUDGET_USD" \
  --output-format json > "$run.json" 2> "$run.err"
rc=$?
rm -f "$STATE/ledger/current"
# Usage-limit hit? (session/weekly limit, rate limit). Then this attempt is
# not counted and the timer simply retries later; after the reset the next
# attempt runs normally. No human needed.
limited=false
if grep -qiE "usage limit|session limit|weekly limit|limit reached|hit your .*limit|rate.?limit|resets at|429" "$run.json" "$run.err" 2>/dev/null \
   && [ "$(jq -r '.num_turns // 0' "$run.json" 2>/dev/null || echo 0)" -le 2 ]; then
  limited=true
fi
# A cycle that was stopped leaves an empty result file. jq prints nothing for
# an empty file and still exits 0, so check for content first: otherwise a
# halted cycle would get no ledger line at all.
if ! { [ -s "$run.json" ] && jq -e -c --arg date "$today" --arg start "$start" --arg end "$(date -Is)" --arg sid "$sid" \
      --argjson secs $((SECONDS - t0)) --argjson rc $rc --argjson limited $limited --argjson halted $halted \
  '{date:$date, start:$start, end:$end, secs:$secs, rc:$rc, limited:$limited, counted:($limited | not), halted:$halted,
    cost_usd:(.total_cost_usd // null), turns:(.num_turns // null),
    session:(.session_id // $sid), is_error:(.is_error // null),
    summary:((.result // "") | tostring | .[-600:])}' "$run.json" >> "$LEDGER" 2>/dev/null; }; then
  jq -nc --arg date "$today" --arg start "$start" --arg end "$(date -Is)" --arg sid "$sid" --argjson rc $rc \
     --argjson secs $((SECONDS - t0)) --argjson limited $limited --argjson halted $halted --arg err "$(tail -c 600 "$run.err")" \
     '{date:$date, start:$start, end:$end, secs:$secs, rc:$rc, limited:$limited, counted:($limited | not), halted:$halted,
       session:$sid, summary:((if $halted then "halted by the owner mid-cycle. " else "no json output: " end) + $err)}' >> "$LEDGER"
fi
echo "cycle done rc=$rc limited=$limited halted=$halted in $((SECONDS - t0))s"
exit 0
