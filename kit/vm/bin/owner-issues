#!/bin/bash
# owner-issues: how the lead reads the owner's issues and reports on them.
# Runs as `agent`. Root-owned, like everything in /opt/agent-kit.
#
#   owner-issues list                     open issues
#   owner-issues show <id>                one issue, with image paths
#   owner-issues update <id> in_progress|done|wontfix [--shot shots/<sha>/<file>.png] [--commit <sha>]   (note on stdin)
#   owner-issues prompt                   the protocol plus open issues (added to the lead's prompt)
#
# Layout (see docs/architecture.md):
#   $STATE/issues/<id>/issue.md, shot.png, markup.png   root-owned: only the owner can write here
#   $STATE/issues/.owner/<id>                           "<status> <date>" when the owner moved it
#   $STATE/issues-out/<id>.md                           the lead's latest update (agent-written)
set -uo pipefail
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
# shellcheck source=/dev/null
source "$ETC/project.env"
# shellcheck source=/dev/null
[ -f "$ETC/caps.env" ] && source "$ETC/caps.env"
# In focus (kit 0.31) the team works through the owner's issues, approved items
# included, before its own roadmap: approved items count as allowed.
[ -f "$STATE/focus" ] && FREE_TAKE_APPROVED=1
IS=$STATE/issues
OUT=$STATE/issues-out
ID_RE='^[0-9]{8}T[0-9]{6}Z-i-[a-f0-9]{6}$'
SHOT_RE='^shots/([0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9a-f]{40})/[A-Za-z0-9._-]+\.png$'
SHA_RE='^[0-9a-f]{7,40}$'
shopt -s nullglob

die() { echo "owner-issues: $*" >&2; exit 2; }
header() { sed -n "1,/^---\$/s/^$2: //p" "$1" 2>/dev/null | head -1; }
body() { sed '1,/^---$/d' "$1" 2>/dev/null; }

# Current status: whichever of the owner's move and the lead's update is newer.
status_of() {
  local id=$1 os="" od="" ls="" ld=""
  [ -f "$IS/.owner/$id" ] && read -r os od < "$IS/.owner/$id"
  if [ -f "$OUT/$id.md" ]; then ls=$(header "$OUT/$id.md" Status); ld=$(header "$OUT/$id.md" Date); fi
  if [ -n "$os" ] && { [ -z "$ls" ] || [[ ! $ld > $od ]]; }; then echo "$os"
  elif [ -n "$ls" ]; then echo "$ls"
  else echo new; fi
}

open_ids() {
  local d id
  for d in "$IS"/2*/; do
    id=$(basename "$d")
    [[ $id =~ $ID_RE ]] && [ -f "$d/issue.md" ] || continue
    case "$(status_of "$id")" in new | in_progress) echo "$id" ;; esac
  done
}

# Open issues for the cycle prompt. A planned issue (kit 0.11) is a backlog
# item the owner approved: it runs as its own one-shot job, which names it.
# Normal cycles leave it alone, unless the owner lets them take approved items.
prompt_ids() {
  local id pid
  for id in $(open_ids); do
    if [ "$(header "$IS/$id/issue.md" Kind)" = planned ]; then
      [ "${FREE_TAKE_APPROVED:-0}" = 1 ] || continue
      # In focus, not one whose backlog item is set for a time: its own job does it (kit 0.31).
      pid=$(grep -oE 'Backlog item:? [0-9]{8}T[0-9]{6}Z-b-[a-f0-9]{6}' "$IS/$id/issue.md" 2> /dev/null | head -1 | grep -oE '[0-9]{8}T[0-9]{6}Z-b-[a-f0-9]{6}')
      if [ -n "$pid" ] && [ -f "$STATE/focus" ] && grep -qx "$pid" "$STATE/focus.scheduled" 2> /dev/null; then continue; fi
    fi
    echo "$id"
  done
}

# Priority of an issue (kit 0.12); issues from older kits are normal.
prio_of() {
  local p
  p=$(header "$IS/$1/issue.md" Priority)
  case "$p" in low | normal | high | urgent) echo "$p" ;; *) echo normal ;; esac
}
# "#12" when the issue has a number (kit 0.12), else nothing.
num_of() {
  local n
  n=$(header "$IS/$1/issue.md" Number)
  [[ $n =~ ^[1-9][0-9]{0,5}$ ]] && echo "#$n"
}
# The owner changed the issue (edited it or added a note) after the lead's last update.
changed() {
  local id=$1 last="" am="" nt=""
  [ -f "$OUT/$id.md" ] && last=$(header "$OUT/$id.md" Date)
  am=$(header "$IS/$id/issue.md" Amended)
  [ -f "$IS/$id/notes.md" ] && nt=$(sed -n 's/^## \([0-9TZ:-]*\) .*/\1/p' "$IS/$id/notes.md" | tail -1)
  local newest=$am
  [[ $nt > $newest ]] && newest=$nt
  [ -n "$newest" ] && [[ $newest > $last ]]
}

# What follows the issue text: status, pictures, files, notes, the last update.
tail_of() {
  local id=$1 f notes
  echo "Status: $(status_of "$id")"
  for f in markup.png shot.png; do
    [ -f "$IS/$id/$f" ] && echo "Image ($f, read it with your file tools): $IS/$id/$f"
  done
  local att=("$IS/$id"/att/*)
  if [ ${#att[@]} -gt 0 ]; then
    echo "Attachments (read them with your file tools):"
    for f in "${att[@]}"; do echo "  $f"; done
  fi
  if [ -f "$IS/$id/notes.md" ]; then
    notes=$(cat "$IS/$id/notes.md")
    echo
    echo "Notes from the owner (newest last):"
    if [ "${2:-}" = short ] && [ ${#notes} -gt 1500 ]; then
      echo "[earlier notes: owner-issues show $id]"
      printf '%s\n' "${notes: -1500}"
    else
      printf '%s\n' "$notes"
    fi
  fi
  [ -f "$OUT/$id.md" ] && { echo; echo "Your last update:"; cat "$OUT/$id.md"; }
  return 0
}

show() {
  cat "$IS/$1/issue.md"
  echo
  tail_of "$1"
}

case "${1:-list}" in
  list)
    n=0
    for id in $(open_ids); do
      n=$((n + 1))
      f=$IS/$id/issue.md
      printf '%-6s %s  %-7s  %-7s  %-11s  %s\n' "$(num_of "$id" | grep . || echo -)" "$id" "$(prio_of "$id")" "$(header "$f" Kind)" \
        "$(status_of "$id")" "$(body "$f" | sed -n 's/^# //p' | head -1 | cut -c1-100)"
    done
    [ "$n" -gt 0 ] || echo "No open owner issues."
    ;;

  show)
    [[ ${2:-} =~ $ID_RE ]] || die "usage: owner-issues show <id>"
    [ -f "$IS/$2/issue.md" ] || die "no such issue: $2"
    show "$2"
    ;;

  update)
    id=${2:-} status=${3:-}
    [[ $id =~ $ID_RE ]] || die "usage: owner-issues update <id> in_progress|done|wontfix [--shot shots/<sha>/<file>.png]"
    [[ $status =~ ^(in_progress|done|wontfix)$ ]] || die "status must be in_progress, done or wontfix"
    [ -f "$IS/$id/issue.md" ] || die "no such issue: $id"
    shift 3
    shot="" commit=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --shot) [[ ${2:-} =~ $SHOT_RE ]] || die "bad --shot (shots/<sha>/<file>.png: the full sha of a merge on main)"; shot=$2 ;;
        --commit) [[ ${2:-} =~ $SHA_RE ]] || die "bad --commit (a commit id, 7 to 40 hex characters)"; commit=$2 ;;
        *) die "unknown argument: $1 (--shot shots/<sha>/<file>.png, --commit <sha>)" ;;
      esac
      shift 2
    done
    mkdir -p "$OUT"
    tmp=$OUT/.$id.tmp
    {
      printf 'Status: %s\nRe: %s\nDate: %s\n' "$status" "$id" "$(date -u +%FT%TZ)"
      [ -n "$shot" ] && printf 'Fixed-shot: %s\n' "$shot"
      [ -n "$commit" ] && printf 'Fixed-in: %s\n' "$commit"
      printf -- '---\n'
      head -c 20000
    } > "$tmp" || die "could not write the update"
    mv "$tmp" "$OUT/$id.md"
    echo "updated $id: $status"
    ;;

  prompt)
    # Printed at the end of the lead's prompt every cycle. Keep the wording
    # neutral: team themes rename roles, this text must fit all of them.
    ids=$(prompt_ids)
    [ -n "$ids" ] || { echo "## Owner issues"; echo; echo "There are no open owner issues right now."; exit 0; }
    cat <<'PROMPT'
## Owner issues

The owner also raises issues: tickets about the game, usually from a screenshot with markup drawn on
it (`markup.png`: the screenshot with the owner's circles and boxes). They live under
`/var/lib/agent-kit/issues/`, which you cannot write to; that is what makes them authentic. Each has a
number (`#12`, the owner uses it) and a priority, listed here most urgent first:
- `urgent`: handle it before you start any new work;
- `high`: plan it into this cycle or the next;
- `normal`: weigh it like a `note` from the inbox when you choose tasks;
- `low`: when there is room.
The owner can change an issue after raising it (its text, kind or priority) and add notes; an issue
marked "changed by the owner since your last update" has something new for you to read.

You triage every issue. Decide who on the team should handle it and hand it to them as a task, or
decline it. Report with `owner-issues update <id> in_progress|done|wontfix` (a short note on stdin):
- `in_progress` once it is assigned (say to whom, and where it is planned);
- `done` when the fix has merged, with `--commit <sha>` (the merge on main); add
  `--shot shots/<sha>/<file>.png` (the full sha of the merge; the gate keeps its screenshots in
  /var/lib/agent-kit/gate/shots/<sha>/) when one of them shows the fix, so the owner sees before and after;
- `wontfix` with the reason, if it conflicts with the charter or is not worth doing.
An issue is shown here every cycle until it is `done` or `wontfix`. The owner can also move it.
Only you, the lead, update issues; your agents do not.
An issue of kind `planned` is a backlog item the owner approved. It is done by the one-shot job that
names it; when such a job runs, set it `in_progress` at the start and `done` when it has merged.

### Open owner issues
PROMPT
    # Most urgent first; the same priority keeps the order the issues were raised.
    for p in urgent high normal low; do
      for id in $ids; do
        [ "$(prio_of "$id")" = "$p" ] || continue
        echo
        mark=""
        changed "$id" && mark=", changed by the owner since your last update"
        n=$(num_of "$id")
        echo "--- ${n:+$n }$id ($p$mark) ---"
        # Long issue texts are cut here to keep the prompt small. Say so; the
        # status, picture and file paths and the latest notes always follow:
        # a lead that is not told would take the first part for the whole issue.
        text=$(cat "$IS/$id/issue.md")
        if [ ${#text} -gt 3000 ]; then
          printf '%s\n' "${text:0:3000}"
          echo "[cut here: this issue is longer. Read all of it: owner-issues show $id]"
        else
          printf '%s\n' "$text"
        fi
        echo
        tail_of "$id" short
        echo
      done
    done
    exit 0
    ;;

  *)
    die "unknown command: $1 (list, show, update, prompt)"
    ;;
esac
