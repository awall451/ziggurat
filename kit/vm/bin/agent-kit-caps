#!/bin/bash
# agent-kit-caps: the team's brakes and models. Run with sudo to change them.
#
#   agent-kit-caps show
#   agent-kit-caps set <KEY> <VALUE>
#
# Keys: MAX_CYCLES_PER_DAY, CYCLE_BUDGET_USD, LEAD_MODEL, FALLBACK_MODEL, and (kit 0.10)
# PLAN_BUDGET_USD, CHAT_BUDGET_USD (a planning cycle, a chat turn) and
# FREE_TAKE_APPROVED (0|1: may normal cycles take approved backlog items), and (kit 0.21)
# CHAT_EFFORT (thinking effort of a chat answer: low, medium, high, xhigh or max).
# Changes go to /etc/agent-kit/caps.env, which lead-cycle reads after
# project.env; the installer never touches it. They apply from the next cycle.
set -uo pipefail
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
CAPS=$ETC/caps.env
KEYS=(MAX_CYCLES_PER_DAY CYCLE_BUDGET_USD LEAD_MODEL FALLBACK_MODEL PLAN_BUDGET_USD CHAT_BUDGET_USD FREE_TAKE_APPROVED CHAT_EFFORT)
# Defaults for the keys added in kit 0.10, when project.env has none.
PLAN_BUDGET_USD=2 CHAT_BUDGET_USD=3 FREE_TAKE_APPROVED=0
# Medium is what Claude Code uses when nothing is set: the default changes nothing.
CHAT_EFFORT=medium

case "${1:-show}" in
  show)
    # shellcheck source=/dev/null
    source "$ETC/project.env"
    # shellcheck source=/dev/null
    [ -f "$CAPS" ] && source "$CAPS"
    for k in "${KEYS[@]}"; do printf '%s=%s\n' "$k" "${!k:-}"; done
    ;;
  set)
    key=${2:-} value=${3:-}
    case "$key" in
      MAX_CYCLES_PER_DAY) [[ $value =~ ^[0-9]{1,3}$ ]] && [ "$value" -le 200 ] || { echo "MAX_CYCLES_PER_DAY: a whole number from 0 to 200" >&2; exit 2; } ;;
      CYCLE_BUDGET_USD) [[ $value =~ ^[0-9]{1,3}(\.[0-9]{1,2})?$ ]] && [ "${value%%.*}" -ge 1 ] && [ "${value%%.*}" -le 500 ] || { echo "CYCLE_BUDGET_USD: a number from 1 to 500" >&2; exit 2; } ;;
      PLAN_BUDGET_USD | CHAT_BUDGET_USD) [[ $value =~ ^[0-9]{1,2}(\.[0-9]{1,2})?$ ]] && [ "$value" != 0 ] && [[ ! $value =~ ^0(\.0+)?$ ]] || { echo "$key: a number from 0.01 to 99" >&2; exit 2; } ;;
      CHAT_EFFORT) [[ $value =~ ^(low|medium|high|xhigh|max)$ ]] || { echo "CHAT_EFFORT: low, medium, high, xhigh or max" >&2; exit 2; } ;;
      FREE_TAKE_APPROVED) [[ $value =~ ^[01]$ ]] || { echo "FREE_TAKE_APPROVED: 0 or 1" >&2; exit 2; } ;;
      LEAD_MODEL | FALLBACK_MODEL) [[ $value =~ ^[a-z][a-z0-9.-]{1,39}$ ]] || { echo "$key: a model name (lowercase letters, digits, dots, dashes)" >&2; exit 2; } ;;
      *) echo "unknown key: $key (allowed: ${KEYS[*]})" >&2; exit 2 ;;
    esac
    # Rewrite the file from scratch so it only ever holds checked KEY=VALUE lines.
    tmp=$CAPS.tmp
    : > "$tmp"
    if [ -f "$CAPS" ]; then
      for k in "${KEYS[@]}"; do
        [ "$k" = "$key" ] && continue
        old=$(sed -n "s/^$k=\([A-Za-z0-9.-]*\)\$/\1/p" "$CAPS" | tail -1)
        [ -n "$old" ] && printf '%s=%s\n' "$k" "$old" >> "$tmp"
      done
    fi
    printf '%s=%s\n' "$key" "$value" >> "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$CAPS"
    echo "$key=$value (from the next cycle)"
    ;;
  *)
    echo "usage: agent-kit-caps show | set <KEY> <VALUE>" >&2
    exit 2
    ;;
esac
