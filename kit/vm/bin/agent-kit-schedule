#!/bin/bash
# agent-kit-schedule: start the team's cycles at set times instead of back to
# back. Run with sudo (the console calls it over ssh).
#
#   agent-kit-schedule show     the schedule and the last lines of its log, as one JSON line
#   agent-kit-schedule set      a new schedule on stdin (checked before it replaces the old one)
#   agent-kit-schedule clear    no schedule: the team is idle (kit 0.35) until a cycle is run, start times are set or a focus starts
#   agent-kit-schedule tick     start a cycle if a slot is due (agent-kit-tick, every minute)
#   agent-kit-schedule skip <slot> <local date>     skip that one start (kit 0.14.1): the owner gave
#                                                   the time to a backlog job
#   agent-kit-schedule unskip <slot> <local date>
#
# The schedule, /etc/agent-kit/schedule:
#   tz Europe/Amsterdam
#   slot daily 01:00
#   slot mon,wed,fri 13:30
#   slot daily 06:00 every=2 from=2026-11-24                  every other day from that date (kit 0.26)
#   slot tue,thu 09:00 every=2 from=2026-11-24 until=2027-01-31   every other week, until that date
#   slot daily 22:00 from=2026-11-24 count=5 until=2026-11-28    five times; `set` works out the last date
#   move 2026-11-21 daily@01:00 03:15     that day only: the 01:00 start is at 03:15 (kit 0.14.1)
#   skip 2026-11-22 mon,wed,fri@13:30     that day only: no 13:30 start (kit 0.14.1)
# Times are local to `tz`. Days: daily, or any of mon tue wed thu fri sat sun.
# `move` and `skip` change one day of a slot, like editing one event of a
# recurring calendar entry; the slot itself stays as it is.
# From kit 0.26 a slot may repeat less often and end, like a calendar's custom
# recurrence: every=N is every N days for `daily` and every N weeks for a list
# of weekdays (weeks counted from the Monday of the week of `from`, which it
# needs); from= and until= are the first and last local dates it may start on;
# count=N ends it after N starts, counted by calendar from `from` (a skipped
# day counts too). `set` writes the date of the last of them as until=.
#
# Without a schedule nothing here does anything, and from kit 0.35 the team is
# idle: no cycle starts unless the owner runs one or puts the team in focus.
# With one, lead-cycle starts a normal cycle only when this script has just
# left a slot marker ($STATE/slot). The lead timer keeps its meaning (on = the
# team may run), so halt, resume and one-shot jobs work as they always did.
#
# A slot is used once. It is skipped, never queued, when the team is halted,
# its timer is off, a cycle is still running or the daily cap is used up; and
# it is not caught up later than GRACE minutes. Every decision is one line in
# $STATE/schedule.log:  <utc time> <slot> <local date> <what happened>
set -uo pipefail
# Root script: never look programs up through an inherited PATH
# (AGENT_KIT_PATH is for the tests).
PATH=${AGENT_KIT_PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}
export PATH LC_ALL=C
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
# shellcheck source=/dev/null
source "$ETC/project.env"
FILE=$ETC/schedule
LEAD=agent-kit-lead
MARK=$STATE/slot             # "<slot> <unix seconds>": written just before a slot's cycle is started
USED=$STATE/schedule.used    # slots already decided: "<slot> <local date>" per line
SKIP=$STATE/schedule.skip    # starts the owner skipped once: "<slot> <local date>" per line
LOG=$STATE/schedule.log
LOCK=${AGENT_KIT_LOCK:-/run/agent-kit-ctl.lock}
ZONES=${AGENT_KIT_ZONEINFO:-/usr/share/zoneinfo}
GRACE=10        # minutes a slot may be late (the VM was busy, or just booted)
MAX_SLOTS=100
TZ_RE='^[A-Za-z][A-Za-z0-9_+-]{0,30}(/[A-Za-z0-9_+-]{1,30}){0,2}$'
TIME_RE='^([01][0-9]|2[0-3]):[0-5][0-9]$'
DATE_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
SLOT_RE='^[a-z,]{3,27}@([01][0-9]|2[0-3]):[0-5][0-9]$'
MAX_EXCEPT=200
DAYS=(mon tue wed thu fri sat sun)
MAX_EVERY=52
MAX_COUNT=500

die() { echo "agent-kit-schedule: $*" >&2; exit 2; }
umask 022
cycle_alive() {
  case "$(systemctl is-active "$LEAD.service" 2>/dev/null)" in
    active | activating | deactivating) return 0 ;;
  esac
  return 1
}
# "wed,mon,wed" -> "mon,wed"; "daily" stays; anything else fails.
days_of() {
  local in=$1 d out=()
  [ "$in" = daily ] && { echo daily; return 0; }
  [[ $in =~ ^[a-z]{3}(,[a-z]{3}){0,6}$ ]] || return 1
  for d in ${in//,/ }; do [[ " ${DAYS[*]} " == *" $d "* ]] || return 1; done
  for d in "${DAYS[@]}"; do [[ ",$in," == *",$d,"* ]] && out+=("$d"); done
  (IFS=,; echo "${out[*]}")
}
has_slots() { [ -f "$FILE" ] && grep -q '^slot ' "$FILE"; }
# Days since 1970-01-01 of a local date (YYYY-MM-DD); its weekday is ${DAYS[(n + 3) % 7]}.
eday() { echo $(($(date -u -d "$1" +%s) / 86400)); }
valid_date() { [[ $1 =~ $DATE_RE ]] && [ "$(date -u -d "$1" +%F 2> /dev/null)" = "$1" ]; }
# Does a slot start on that date? days every from until date (every 1 when not set).
occurs() {
  local days=$1 every=${2:-1} from=$3 until=$4 day=$5 d f
  [ -z "$from" ] || [[ ! $day < $from ]] || return 1
  [ -z "$until" ] || [[ ! $day > $until ]] || return 1
  [ "$every" -gt 1 ] || return 0
  [ -n "$from" ] || return 1
  d=$(eday "$day") f=$(eday "$from")
  if [ "$days" = daily ]; then
    (((d - f) % every == 0))
  else
    # Weeks, counted from the Monday of the week of `from`.
    ((((d - (d + 3) % 7) - (f - (f + 3) % 7)) / 7 % every == 0))
  fi
}
# The date of the count-th start of a slot from `from`: days every from count.
last_of() {
  local days=$1 every=$2 f n=0 d mon wf
  f=$(eday "$3")
  if [ "$days" = daily ]; then
    d=$((f + ($4 - 1) * every))
  else
    wf=$((f - (f + 3) % 7))
    d=$((f - 1))
    while [ "$n" -lt "$4" ]; do
      d=$((d + 1))
      mon=$((d - (d + 3) % 7))
      # A week that is not one of its weeks: on to the next one.
      if (((mon - wf) / 7 % every != 0)); then d=$((mon + 6)); continue; fi
      [[ ",$days," == *",${DAYS[(d + 3) % 7]},"* ]] && n=$((n + 1))
    done
  fi
  date -u -d "@$((d * 86400))" +%F
}

case "${1:-show}" in
  show)
    tz=""
    [ -f "$FILE" ] && tz=$(sed -n 's/^tz //p' "$FILE" | head -1)
    {
      [ -f "$FILE" ] && sed -n 's/^slot //p' "$FILE"
    } | jq -Rnc --arg tz "$tz" --arg log "$(tail -n 60 "$LOG" 2>/dev/null)" --arg ex "$([ -f "$FILE" ] && grep -E '^(move|skip) ' "$FILE")" \
      '{tz: ($tz | select(. != "") // null),
        slots: [inputs | split(" ") | {days: (.[0] | split(",")), time: .[1]}
          + ([.[2:][] | select(test("^(every|from|until|count)=")) | split("=") | {(.[0]): (if .[0] == "every" or .[0] == "count" then (.[1] | tonumber) else .[1] end)}] | add // {})],
        changes: ($ex | split("\n") | map(select(. != "") | split(" ") | {kind: .[0], date: .[1], slot: .[2], time: (.[3] // null)})),
        log: ($log | split("\n") | map(select(. != "")))}'
    ;;

  set)
    tz="" slots=() names=() excepts=() n=0
    while IFS= read -r line || [ -n "$line" ]; do
      n=$((n + 1))
      [ "$n" -le 400 ] || die "too many lines"
      line=${line%$'\r'}
      [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
      read -r word a b extra <<< "$line"
      case "$word" in
        tz)
          [ -z "$tz" ] && [ -z "${b:-}" ] || die "line $n: one 'tz <zone>' line"
          [[ ${a:-} =~ $TZ_RE ]] && [ -f "$ZONES/$a" ] || die "line $n: unknown time zone: ${a:-}"
          tz=$a
          ;;
        slot)
          d=$(days_of "${a:-}") || die "line $n: days must be 'daily' or a list of mon tue wed thu fri sat sun"
          [[ ${b:-} =~ $TIME_RE ]] || die "line $n: the time must be HH:MM, 00:00 to 23:59"
          [[ " ${names[*]:-} " == *" $d@$b "* ]] && die "line $n: the same slot twice: $d $b"
          every=1 from="" until="" count=""
          for kv in ${extra:-}; do
            case "$kv" in
              every=*) every=${kv#*=}; [[ $every =~ ^[0-9]{1,2}$ ]] && [ "$every" -ge 1 ] && [ "$every" -le "$MAX_EVERY" ] || die "line $n: every must be 1 to $MAX_EVERY" ;;
              from=*) from=${kv#*=}; valid_date "$from" || die "line $n: from must be a date, YYYY-MM-DD" ;;
              until=*) until=${kv#*=}; valid_date "$until" || die "line $n: until must be a date, YYYY-MM-DD" ;;
              count=*) count=${kv#*=}; [[ $count =~ ^[0-9]{1,3}$ ]] && [ "$count" -ge 1 ] && [ "$count" -le "$MAX_COUNT" ] || die "line $n: count must be 1 to $MAX_COUNT" ;;
              *) die "line $n: slot <days> <HH:MM> [every=N] [from=YYYY-MM-DD] [until=YYYY-MM-DD] [count=N]" ;;
            esac
          done
          { [ "$every" = 1 ] && [ -z "$count" ]; } || [ -n "$from" ] || die "line $n: every and count need from=<first date>"
          [ -z "$from" ] || [ -z "$until" ] || [[ ! $until < $from ]] || die "line $n: until is before from"
          if [ -n "$count" ]; then
            last=$(last_of "$d" "$every" "$from" "$count")
            { [ -n "$until" ] && [[ $until < $last ]]; } || until=$last
          fi
          line="slot $d $b"
          [ "$every" = 1 ] || line+=" every=$every"
          [ -z "$from" ] || line+=" from=$from"
          [ -z "$until" ] || line+=" until=$until"
          [ -z "$count" ] || line+=" count=$count"
          names+=("$d@$b")
          slots+=("$line")
          ;;
        move)
          [[ ${a:-} =~ $DATE_RE ]] && [[ ${b:-} =~ $SLOT_RE ]] && [[ ${extra:-} =~ $TIME_RE ]] || die "line $n: move <YYYY-MM-DD> <days@HH:MM> <HH:MM>"
          excepts+=("move $a $b $extra")
          ;;
        skip)
          [[ ${a:-} =~ $DATE_RE ]] && [[ ${b:-} =~ $SLOT_RE ]] && [ -z "${extra:-}" ] || die "line $n: skip <YYYY-MM-DD> <days@HH:MM>"
          excepts+=("skip $a $b")
          ;;
        *) die "line $n: expected 'tz <zone>', 'slot <days> <HH:MM>', 'move …' or 'skip …'" ;;
      esac
    done
    [ -n "$tz" ] || die "the schedule needs a 'tz <zone>' line"
    [ ${#slots[@]} -gt 0 ] || die "the schedule has no slots (use 'clear' for none)"
    [ ${#slots[@]} -le "$MAX_SLOTS" ] || die "at most $MAX_SLOTS slots"
    [ ${#excepts[@]} -le "$MAX_EXCEPT" ] || die "at most $MAX_EXCEPT one-day changes"
    exec 8> "$LOCK"
    flock 8
    {
      echo "tz $tz"
      for s in "${slots[@]}"; do echo "$s"; done
      for e in "${excepts[@]}"; do echo "$e"; done
    } > "$FILE.tmp" || die "could not write the schedule"
    chmod 644 "$FILE.tmp"
    mv "$FILE.tmp" "$FILE"
    # A slot whose minute has just passed must not fire because the schedule changed now.
    "$0" tick --mark-only < /dev/null > /dev/null 2>&1 8>&-
    echo "schedule set: ${#slots[@]} slot(s), times in $tz"
    ;;

  clear)
    exec 8> "$LOCK"
    flock 8
    rm -f "$FILE" "$MARK" "$USED"
    echo "no schedule: the team is idle until a cycle is run, start times are set or a focus starts"
    ;;

  tick)
    has_slots || exit 0
    mark_only=0
    [ "${2:-}" = "--mark-only" ] && mark_only=1
    [ "$mark_only" = 1 ] || { exec 8> "$LOCK"; flock 8; }
    tz=$(sed -n 's/^tz //p' "$FILE" | head -1)
    [[ $tz =~ $TZ_RE ]] && [ -f "$ZONES/$tz" ] || exit 0
    now=${AGENT_KIT_NOW:-$(date +%s)}
    [[ $now =~ ^[0-9]{9,11}$ ]] || exit 0
    touch "$USED"
    note() { # slot, local date, what happened
      printf '%s %s %s %s\n' "$(date -u -d "@$now" +%FT%TZ)" "$1" "$2" "$3" >> "$LOG"
      chmod 644 "$LOG"
      if [ "$(wc -l < "$LOG")" -gt 500 ]; then tail -n 400 "$LOG" > "$LOG.tmp" && chmod 644 "$LOG.tmp" && mv "$LOG.tmp" "$LOG"; fi
    }
    # Oldest first, so that of two slots a few minutes apart the earlier one gets the cycle.
    for ((m = GRACE; m >= 0; m--)); do
      read -r dow hm day <<< "$(TZ=$tz date -d "@$((now - m * 60))" '+%a %H:%M %F')"
      dow=${dow,,}
      while read -r _ days time rest; do
        [ "$time" = "$hm" ] || continue
        moved="" every=1 from="" until=""
        for kv in ${rest:-}; do
          case "$kv" in
            moved=*) moved=${kv#*=} ;;
            every=*) every=${kv#*=} ;;
            from=*) from=${kv#*=} ;;
            until=*) until=${kv#*=} ;;
          esac
        done
        if [ -n "${moved:-}" ]; then
          # A start moved to this minute for today: it keeps the name of its slot.
          slot=$days@$moved
        else
          [ "$days" = daily ] || [[ ",$days," == *",$dow,"* ]] || continue
          # Every N days or weeks, from and until (kit 0.26).
          occurs "$days" "$every" "$from" "$until" "$day" || continue
          slot=$days@$time
          # Changed for that day only: skipped, or moved to another time.
          if grep -qE "^(skip $day $slot|move $day $slot [0-9:]+)\$" "$FILE"; then continue; fi
        fi
        grep -qxF "$slot $day" "$USED" && continue
        echo "$slot $day" >> "$USED"
        [ "$mark_only" = 1 ] && continue
        if grep -qxF "$slot $day" "$SKIP" 2>/dev/null; then note "$slot" "$day" "skipped: the owner gave this time to a backlog job"; continue; fi
        if grep -q '^stop' "$STATE/control" 2>/dev/null; then note "$slot" "$day" "skipped: halted"; continue; fi
        # Focus (kit 0.27): this team in focus runs back to back; paused for another team's focus, it waits.
        if [ -f "$STATE/focus" ]; then note "$slot" "$day" "skipped: in focus, cycles run back to back"; continue; fi
        if [ -f "$STATE/paused" ]; then
          pu=$(sed -n 's/.*until=\([0-9]*\).*/\1/p' "$STATE/paused" | head -1)
          pf=$(sed -n 's/.*for=\([A-Za-z0-9._-]*\).*/\1/p' "$STATE/paused" | head -1)
          if [[ ${pu:-} =~ ^[0-9]+$ ]] && [ "$now" -lt "$pu" ]; then note "$slot" "$day" "skipped: paused for focus on ${pf:-another team}"; continue; fi
        fi
        if [ -e "$STATE/oneshot" ]; then note "$slot" "$day" "skipped: a one-shot job is in progress"; continue; fi
        if [ -e "$STATE/halt-after" ]; then note "$slot" "$day" "skipped: a halt is pending"; continue; fi
        if [ "$(systemctl is-enabled "$LEAD.timer" 2>/dev/null)" != enabled ]; then note "$slot" "$day" "skipped: timer off"; continue; fi
        if cycle_alive; then note "$slot" "$day" "skipped: a cycle is running"; continue; fi
        # The daily cap, counted as lead-cycle counts it (the owner's caps.env wins).
        cap=$(sed -nE 's/^MAX_CYCLES_PER_DAY=([0-9]{1,5})$/\1/p' "$ETC/project.env" "$ETC/caps.env" 2>/dev/null | tail -1)
        today=$(jq -s --arg d "$(date -d "@$now" +%F)" '[.[] | select(.date == $d and .counted != false)] | length' "$STATE/ledger/cycles.jsonl" 2>/dev/null)
        if [ -n "$cap" ] && [ "${today:-0}" -ge "$cap" ]; then note "$slot" "$day" "skipped: daily cap (${today:-0}/$cap)"; continue; fi
        printf '%s %s\n' "$slot" "$now" > "$MARK.tmp" && chmod 644 "$MARK.tmp" && mv "$MARK.tmp" "$MARK"
        if systemctl start --no-block "$LEAD.service" > /dev/null 2>&1; then
          note "$slot" "$day" "started"
        else
          rm -f "$MARK"
          note "$slot" "$day" "failed: the cycle could not be started"
        fi
      done < <(grep '^slot ' "$FILE"; grep -E "^move $day " "$FILE" | while read -r _ _ s t; do
        # A start moved to this time today: it runs as its own slot, at the new time.
        [ "$t" = "$hm" ] && echo "slot ${s%@*} $hm moved=${s#*@}"
      done)
    done
    if [ "$(wc -l < "$USED")" -gt 400 ]; then tail -n 200 "$USED" > "$USED.tmp" && mv "$USED.tmp" "$USED"; fi
    exit 0
    ;;

  skip | unskip)
    slot=${2:-} day=${3:-}
    [[ $slot =~ ^[a-z,]{3,27}@[0-9]{2}:[0-9]{2}$ ]] || die "bad slot (days@HH:MM)"
    [[ $day =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die "bad date (YYYY-MM-DD)"
    exec 8> "$LOCK"
    flock 8
    touch "$SKIP"
    grep -vxF "$slot $day" "$SKIP" > "$SKIP.tmp" || true
    [ "$1" = skip ] && echo "$slot $day" >> "$SKIP.tmp"
    # Old entries go after a while: keep the last 200.
    tail -n 200 "$SKIP.tmp" > "$SKIP.new" && chmod 644 "$SKIP.new" && mv "$SKIP.new" "$SKIP"
    rm -f "$SKIP.tmp"
    echo "$1 $slot $day"
    ;;

  *)
    die "usage: agent-kit-schedule show | set | clear | tick | skip <slot> <date> | unskip <slot> <date>"
    ;;
esac
