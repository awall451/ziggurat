#!/bin/bash
# Kill switch, kept under its old name. Run with sudo.
#   sudo agent-kit-stop [reason]   -> same as agent-kit-halt
#   sudo agent-kit-stop --resume   -> control=run only (agent-kit-resume --no-timer)
# The control file is root-owned; agents can read it but not change it.
BIN=$(dirname "$(readlink -f "$0")")
if [ "${1:-}" = "--resume" ]; then exec "$BIN/agent-kit-resume" --no-timer; fi
exec "$BIN/agent-kit-halt" "$@"
