#!/bin/bash
# owner-backlog: how the lead proposes work to the owner (kit 0.10). Runs as
# `agent`. Root-owned, like everything in /opt/agent-kit.
#
#   owner-backlog propose --title T --minutes N --cost USD --confidence low|medium|high
#                 [--areas A] [--depends <pid>,...] [--order N] [--risk R]    (why and steps on stdin)
#                 [--model sonnet|opus]     the model you would give the tech lead for this job (kit 0.22);
#                                           the owner sees it and may choose the other
#   owner-backlog revise <pid> [the same flags]       a new revision; flags left out keep their value,
#                                                     the body is replaced only when stdin has text
#   owner-backlog taken <pid>                         a normal cycle took an approved item (only when
#                                                     the owner allows it)
#   owner-backlog list | show <pid>
#   owner-backlog prompt                              protocol, recent cycle numbers, proposals
#   owner-backlog plan <plan-id> [--head]             the rules of a planning cycle
#   owner-backlog chat <plan-id> <msgid> [--fresh]    the notice of a chat turn, with the message;
#                                                     --fresh: for a new session after a long pause, with
#                                                     the proposals and the chat so far (kit 0.21)
#
# Layout: see agent-kit-backlog. Everything this script writes is data the
# console checks; nothing here can change what the owner decided.
set -uo pipefail
ETC=${AGENT_KIT_ETC:-/etc/agent-kit}
# shellcheck source=/dev/null
source "$ETC/project.env"
# shellcheck source=/dev/null
[ -f "$ETC/caps.env" ] && source "$ETC/caps.env"
# In focus (kit 0.31) the team works through the owner's issues, approved items
# included, before its own roadmap: approved items count as allowed.
[ -f "$STATE/focus" ] && FREE_TAKE_APPROVED=1
# Items whose job is set for a time (agent-kit-focus keeps the list in focus): not to be taken.
scheduled() { [ -f "$STATE/focus" ] && grep -qx "$1" "$STATE/focus.scheduled" 2> /dev/null; }
BL=$STATE/backlog
OUT=$STATE/backlog-out
LEDGER=$STATE/ledger/cycles.jsonl
PLAN_RE='^[0-9]{8}T[0-9]{6}Z-p-[a-z0-9-]{1,40}$'
PID_RE='^[0-9]{8}T[0-9]{6}Z-b-[a-f0-9]{6}$'
MSG_RE='^[0-9]{8}T[0-9]{6}Z-c-[a-f0-9]{6}$'
LINE_RE='^[^[:cntrl:]]{1,300}$'
MAX_BODY=8000
shopt -s nullglob

die() { echo "owner-backlog: $*" >&2; exit 2; }
header() { sed -n "1,/^---\$/s/^$2: //p" "$1" 2>/dev/null | head -1; }
body() { sed '1,/^---$/d' "$1" 2>/dev/null; }
current_plan() { local p; read -r p _ < "$BL/current" 2>/dev/null; [[ ${p:-} =~ $PLAN_RE ]] && echo "$p"; }

# The owner's decision on a proposal: approved/rejected count only for the
# revision the owner saw. A later revision needs a new decision.
status_of() {
  local pid=$1 os="" orev="" rev
  rev=$(header "$OUT/$pid.md" Rev)
  [ -f "$BL/.owner/$pid" ] && read -r os orev _ < "$BL/.owner/$pid"
  if [ -n "$os" ] && [ "$os" != new ] && [ "${orev:-}" = "$rev" ]; then
    if [ "$os" = approved ] && [ -e "$OUT/taken/$pid" ]; then echo taken; else echo "$os"; fi
  elif [ -n "$os" ] && [ "$os" != new ]; then echo "revised after $os"
  else echo new; fi
}

ids() { local f; for f in "$OUT"/2*-b-*.md; do f=$(basename "$f" .md); [[ $f =~ $PID_RE ]] && echo "$f"; done; }

write_proposal() { # $1 pid, $2 plan, $3 rev; fields in globals; body in $text
  mkdir -p "$OUT"
  local tmp=$OUT/.$1.tmp
  {
    printf 'Plan: %s\nRev: %s\nDate: %s\nTitle: %s\nMinutes: %s\nCost-usd: %s\nConfidence: %s\n' \
      "$2" "$3" "$(date -u +%FT%TZ)" "$title" "$minutes" "$cost" "$confidence"
    [ -n "$areas" ] && printf 'Areas: %s\n' "$areas"
    [ -n "$depends" ] && printf 'Depends: %s\n' "$depends"
    [ -n "$order" ] && printf 'Order: %s\n' "$order"
    [ -n "$risk" ] && printf 'Risk: %s\n' "$risk"
    [ -n "$model" ] && printf 'Model: %s\n' "$model"
    printf -- '---\n%s\n' "$text"
  } > "$tmp" || die "could not write the proposal"
  mv "$tmp" "$OUT/$1.md"
}

parse_flags() {
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || die "flag $1 needs a value"
    case "$1" in
      --title) title=$2 ;;
      --minutes) minutes=$2 ;;
      --cost) cost=$2 ;;
      --confidence) confidence=$2 ;;
      --areas) areas=$2 ;;
      --depends) depends=$2 ;;
      --order) order=$2 ;;
      --risk) risk=$2 ;;
      --model) model=$2 ;;
      *) die "unknown flag: $1" ;;
    esac
    shift 2
  done
  [[ $title =~ $LINE_RE ]] || die "--title: one line, at most 300 characters"
  [[ $minutes =~ ^[0-9]{1,2}$ ]] && [ "$minutes" -ge 1 ] && [ "$minutes" -le 90 ] \
    || die "--minutes: 1 to 90. Split larger work into several proposals with --order and --depends"
  [[ $cost =~ ^[0-9]{1,3}(\.[0-9]{1,2})?$ ]] || die "--cost: US dollars, like 1.50"
  [[ $confidence =~ ^(low|medium|high)$ ]] || die "--confidence: low, medium or high"
  [ -z "$areas" ] || [[ $areas =~ $LINE_RE ]] || die "--areas: one line, at most 300 characters"
  [ -z "$risk" ] || [[ $risk =~ $LINE_RE ]] || die "--risk: one line, at most 300 characters"
  [ -z "$order" ] || [[ $order =~ ^[0-9]{1,3}$ ]] || die "--order: a number"
  [ -z "$model" ] || [[ $model =~ ^(sonnet|opus)$ ]] || die "--model: sonnet or opus"
  if [ -n "$depends" ]; then
    local d
    IFS=, read -ra deps <<< "$depends"
    [ ${#deps[@]} -le 10 ] || die "--depends: at most 10"
    for d in "${deps[@]}"; do [[ $d =~ $PID_RE ]] && [ -f "$OUT/$d.md" ] || die "--depends: unknown proposal $d"; done
  fi
  return 0
}

read_body() {
  text=$(head -c $((MAX_BODY + 1)))
  [ ${#text} -le $MAX_BODY ] || die "the text is longer than $MAX_BODY bytes: keep a proposal short"
}

case "${1:-list}" in
  propose)
    shift
    plan=$(current_plan) || die "there is no planning request to propose against"
    # The owner's cap for this plan (kit 0.15).
    max=$(header "$BL/plans/$plan/request.md" Max-proposals)
    if [[ $max =~ ^[1-8]$ ]]; then
      n=0
      for f in "$OUT"/*.md; do [ "$(header "$f" Plan)" = "$plan" ] && n=$((n + 1)); done
      [ "$n" -lt "$max" ] || die "the owner asked for at most $max proposals in this plan: revise one instead (owner-backlog revise <pid>)"
    fi
    title="" minutes="" cost="" confidence="" areas="" depends="" order="" risk="" model=""
    parse_flags "$@"
    read_body
    [ -n "$text" ] || die "write why and the steps on stdin"
    pid=$(date -u +%Y%m%dT%H%M%SZ)-b-$(head -c 3 /dev/urandom | od -An -tx1 | tr -d ' \n')
    write_proposal "$pid" "$plan" 1
    echo "proposed $pid"
    ;;

  revise)
    pid=${2:-}
    [[ $pid =~ $PID_RE ]] && [ -f "$OUT/$pid.md" ] || die "usage: owner-backlog revise <pid> [flags] (no such proposal)"
    shift 2
    f=$OUT/$pid.md
    plan=$(header "$f" Plan) rev=$(header "$f" Rev)
    [[ $rev =~ ^[0-9]{1,4}$ ]] || rev=1
    title=$(header "$f" Title) minutes=$(header "$f" Minutes) cost=$(header "$f" Cost-usd)
    confidence=$(header "$f" Confidence) areas=$(header "$f" Areas) depends=$(header "$f" Depends)
    order=$(header "$f" Order) risk=$(header "$f" Risk) model=$(header "$f" Model)
    parse_flags "$@"
    old=$(body "$f")
    if [ -t 0 ]; then text=""; else read_body; fi
    [ -n "$text" ] || text=$old
    write_proposal "$pid" "$plan" $((rev + 1))
    echo "revised $pid: revision $((rev + 1))"
    ;;

  taken)
    pid=${2:-}
    [[ $pid =~ $PID_RE ]] && [ -f "$OUT/$pid.md" ] || die "usage: owner-backlog taken <pid>"
    [ "${FREE_TAKE_APPROVED:-0}" = 1 ] || die "the owner has not allowed normal cycles to take approved items"
    [ "$(status_of "$pid")" = approved ] || die "$pid is not approved"
    scheduled "$pid" && die "$pid is set for a time: its own job does it"
    mkdir -p "$OUT/taken"
    date -u +%FT%TZ > "$OUT/taken/$pid"
    echo "taken $pid"
    ;;

  list)
    n=0
    for pid in $(ids); do
      n=$((n + 1))
      f=$OUT/$pid.md
      printf '%s  %-18s  %3s min  $%-6s  %-6s  %s\n' "$pid" "$(status_of "$pid")" "$(header "$f" Minutes)" \
        "$(header "$f" Cost-usd)" "$(header "$f" Confidence)" "$(header "$f" Title)"
    done
    [ "$n" -gt 0 ] || echo "No proposals."
    ;;

  show)
    pid=${2:-}
    [[ $pid =~ $PID_RE ]] && [ -f "$OUT/$pid.md" ] || die "usage: owner-backlog show <pid>"
    echo "Status: $(status_of "$pid")"
    cat "$OUT/$pid.md"
    ;;

  prompt)
    # Printed in the lead's prompt every cycle. Neutral wording: team themes
    # rename roles, this text must fit all of them.
    cat <<'EOF'
## Backlog: proposals to the owner

Besides your own planning, the owner can ask you to plan bigger work together: a planning cycle, in
which you write proposals and no code. The owner reviews them on the console and approves, rejects
or discusses them with you. `owner-backlog list` shows them with the owner's decision; `owner-backlog
show <pid>` shows one. An approved item runs as a one-shot job the owner starts, now or at a set time.
EOF
    if [ "${FREE_TAKE_APPROVED:-0}" = 1 ]; then
      approved=()
      for pid in $(ids); do [ "$(status_of "$pid")" = approved ] && ! scheduled "$pid" && approved+=("$pid"); done
      if [ ${#approved[@]} -gt 0 ]; then
        echo
        echo "The owner allows normal cycles to take approved items. When you choose this cycle's work, you may"
        echo "take one of these (the oldest first, unless its dependencies are not done): mark it with"
        echo "\`owner-backlog taken <pid>\` before you start, and work it as the proposal says."
        for pid in "${approved[@]}"; do
          printf -- '- %s: %s (%s min, $%s)\n' "$pid" "$(header "$OUT/$pid.md" Title)" "$(header "$OUT/$pid.md" Minutes)" "$(header "$OUT/$pid.md" Cost-usd)"
        done
      fi
    fi
    ;;

  plan)
    id=${2:-}
    [[ $id =~ $PLAN_RE ]] && [ -f "$BL/plans/$id/request.md" ] || die "usage: owner-backlog plan <plan-id> [--head]"
    if [ "${3:-}" = "--head" ]; then
      cat <<EOF
**Read this first: this cycle is a planning cycle.** The owner started this single cycle to plan
work together with you: planning request \`$id\`. You write proposals and **no code**: no edits,
no branches, no worktrees, no gate submissions, no agents that change files. The section "Planning
cycle: this cycle only" at the end of this prompt holds the request and replaces the usual steps of a
cycle wherever the two differ. Read what follows for who is on your team and your rules.
EOF
      exit 0
    fi
    [ -z "${3:-}" ] || die "usage: owner-backlog plan <plan-id> [--head]"
    focus=$(body "$BL/plans/$id/request.md")
    max=$(header "$BL/plans/$id/request.md" Max-proposals)
    if [[ $max =~ ^[1-8]$ ]]; then howmany="At most $max proposals (the owner's limit for this plan), most valuable first."
    else howmany="Three to eight proposals, most valuable first."; fi
    cat <<EOF
## Planning cycle: this cycle only

The owner asks you to find what to do next and to propose it, with an estimate for each item. When
this cycle ends the team goes back to what it was doing before. Afterwards the owner may talk with
you about the proposals: each message resumes this same session for one answer, so what you read
now stays with you.

### What the owner asked
EOF
    if [ -n "${focus//[[:space:]]/}" ]; then
      printf '\n%s\n' "$focus"
    elif ! compgen -G "$BL/plans/$id/att/*" > /dev/null; then
      printf '\nNo focus given: look at the whole project.\n'
    fi
    # Files the owner attached to the request (kit 0.30).
    if compgen -G "$BL/plans/$id/att/*" > /dev/null; then
      printf '\n### Files the owner attached\n\nRead every one of these in full before anything else: they are what the owner wants this\nplan made from (a review, a handoff, notes). Where they and the text above differ, the files say\nwhat to work on. Name the file and the part a proposal comes from.\n\n'
      for f in "$BL/plans/$id/att/"*; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        printf -- '- `%s` (%s bytes)\n' "$f" "$(stat -c %s "$f")"
      done
    fi
    cat <<EOF

### How to work this cycle

- **Read before you read code.** Start from your own notes (STATE.md, the roadmap, the journal) and
  the open owner messages and issues. Open code only where you need it to judge the size of a step.
- **Write no code.** Do not edit files, create branches or worktrees, submit to the gate, or start
  agents that do. Your file tools are limited this cycle; use the shell only to read and for
  \`owner-backlog\`.
- **One proposal per job, at most 90 minutes each.** Larger work becomes several proposals, with
  \`--order\` (1, 2, 3...) and \`--depends <pid>\`. Each proposal says why, the steps, the areas it
  touches (not single files) and the main risk.
- **Estimate honestly.** Minutes of wall clock and US dollars for the job as a one-shot cycle, and how
  sure you are. Base it on the recent numbers below and on your own judgement.
- **Say which model the job's tech lead should run on**, with \`--model\`: \`sonnet\` for small or
  routine work (docs, data, a small fix), \`opus\` for real engineering or design. It is the choice you
  would make anyway when you start that agent. The owner sees it and may choose the other.
- **A handful, not a list of everything.** $howmany

Write each with:

    owner-backlog propose --title "..." --minutes 45 --cost 1.20 --confidence medium \\
      --areas "..." --risk "..." --model sonnet [--order 1] [--depends <pid>]  <<'TEXT'
    Why: ...
    Steps:
    1. ...
    TEXT

Then end the cycle with a short summary of what you proposed. Do not look for more work.

### Recent cycles (for your estimates)

EOF
    if [ -s "$LEDGER" ]; then
      tail -n 10 "$LEDGER" | jq -r '"- \(.start // "?" | .[0:16])  \(.kind // (if .oneshot then "oneshot" else "normal" end))  \((.secs // 0) / 60 | floor) min  $\(.cost_usd // 0 | . * 100 | round / 100)  \(.turns // "?") turns"' 2>/dev/null
      # How the estimates held up (kit 0.19): jobs that had one and ran to their end.
      jq -rs '[.[] | select((.est_min // 0) > 0 and (.secs // 0) > 0 and .halted != true and .limited != true and .overrun != true)
                   | (.secs / 60 / .est_min)] | .[-10:] | sort
              | if length >= 3 then "\nThe last \(length) jobs with an estimate ran \(.[((length - 1) / 2 | floor)] * 10 | round / 10) times their estimate (the middle one). Allow for that in your estimates." else empty end' "$LEDGER" 2>/dev/null
    else
      echo "No cycles recorded yet."
    fi
    ;;

  chat)
    id=${2:-} msg=${3:-}
    [[ $id =~ $PLAN_RE ]] && [[ $msg =~ $MSG_RE ]] && [ -f "$BL/chat/$id/$msg.md" ] || die "usage: owner-backlog chat <plan-id> <msgid> [--fresh]"
    fresh=0
    if [ "${4:-}" = "--fresh" ]; then fresh=1; elif [ -n "${4:-}" ]; then die "usage: owner-backlog chat <plan-id> <msgid> [--fresh]"; fi
    if [ "$fresh" = 1 ]; then
      # A new session after a long pause (kit 0.21): the planning session would
      # have to be read again in full, so this one starts from what matters of it.
      cat <<EOF
[agent-kit owner chat] This is the owner, through the kit, about the proposals of a planning session.
You are the lead of this project's team. You planned this work in an earlier session that is no longer
in your memory: the pause since was long, and reading all of it again would cost more than it is worth.
Below are the planning request, your proposals as they stand with the owner's decisions, and the chat
so far. Your charter is \`/opt/agent-kit/CHARTER.md\` and your notes are in \`docs/agents/STATE.md\`: read
them, or code, only when the owner's message needs it.

Answer in a few plain lines. You may change proposals (\`owner-backlog revise <pid>\`) or add new ones
(\`owner-backlog propose\`) when the owner asks or agrees; say which you changed. No code: no edits, no
branches, no agents. The owner decides on the backlog page.

## The planning request

EOF
      focus=$(body "$BL/plans/$id/request.md" 2>/dev/null | head -c 4000)
      if [ -n "${focus//[[:space:]]/}" ]; then printf '%s\n' "$focus"; else echo "Find what to do next."; fi
      printf '\n## Your proposals\n\n'
      n=0
      for f in "$OUT"/*.md; do
        pid=$(basename "$f" .md)
        [[ $pid =~ $PID_RE ]] && [ "$(header "$f" Plan)" = "$id" ] || continue
        n=$((n + 1))
        printf '### `%s` %s\n' "$pid" "$(header "$f" Title)"
        printf 'Status: %s. Revision %s. Estimate: %s minutes, $%s, confidence %s.\n\n' "$(status_of "$pid")" "$(header "$f" Rev)" "$(header "$f" Minutes)" "$(header "$f" Cost-usd)" "$(header "$f" Confidence)"
        body "$f" | head -c 3000
        printf '\n\n'
      done
      [ "$n" -gt 0 ] || printf 'None on file.\n\n'
      printf '## The chat so far (oldest first)\n\n'
      n=0
      for f in "$BL/chat/$id"/*.md; do
        m=$(basename "$f" .md)
        [[ $m =~ $MSG_RE ]] && [ "$m" != "$msg" ] || continue
        n=$((n + 1))
      done
      skip=$((n > 12 ? n - 12 : 0)) i=0
      [ "$skip" -gt 0 ] && printf '(%s earlier messages left out.)\n\n' "$skip"
      for f in "$BL/chat/$id"/*.md; do
        m=$(basename "$f" .md)
        [[ $m =~ $MSG_RE ]] && [ "$m" != "$msg" ] || continue
        i=$((i + 1)); [ "$i" -gt "$skip" ] || continue
        printf '**Owner:**\n'; body "$f" | head -c 2000; printf '\n\n'
        if [ -f "$OUT/chat/$id/$m.md" ] && [ "$(header "$OUT/chat/$id/$m.md" Status)" = ok ]; then
          printf '**You:**\n'; body "$OUT/chat/$id/$m.md" | head -c 2000; printf '\n\n'
        fi
      done
      [ "$n" -gt 0 ] || printf 'Nothing yet.\n\n'
    else
      cat <<EOF
[agent-kit owner chat] This is the owner, through the kit, about the proposals of this planning
session. Answer in a few plain lines. You may change proposals (\`owner-backlog revise <pid>\`) or add
new ones (\`owner-backlog propose\`) when the owner asks or agrees; say which you changed. Still no
code: no edits, no branches, no agents. The owner decides on the backlog page.

EOF
    fi
    # What the team is doing right now, so the lead can keep it in mind.
    job=""
    [ -r "$STATE/oneshot" ] && read -r job jsince _ < "$STATE/oneshot"
    if [[ ${job:-} =~ ^[0-9]{8}T[0-9]{6}Z-o-[a-z0-9-]{1,40}$ ]] && [ -r "$STATE/inbox/$job/message.md" ]; then
      item=$(body "$STATE/inbox/$job/message.md" | grep -m1 -oE '^Backlog item [0-9]{8}T[0-9]{6}Z-b-[a-f0-9]{6}' | awk '{print $3}')
      echo
      if [ -n "$item" ] && [ -f "$OUT/$item.md" ]; then
        echo "Right now a one-shot job is running in its own cycle (since ${jsince:-?}): backlog item \`$item\`,"
        echo "\"$(header "$OUT/$item.md" Title)\". The owner started it from this backlog. Keep it in mind: that work is in"
        echo "progress, so do not propose it again, and say so if a change you discuss would touch it."
      else
        echo "Right now a one-shot job is running in its own cycle (since ${jsince:-?}): owner message \`$job\`."
      fi
    elif [ -s "$STATE/ledger/current" ]; then
      echo
      echo "Right now a normal cycle of the team is running. Keep in mind that the code may change while you talk."
    fi
    echo
    echo "The owner's message:"
    echo
    body "$BL/chat/$id/$msg.md"
    ;;

  *)
    die "unknown command: $1 (propose, revise, taken, list, show, prompt, plan, chat)"
    ;;
esac
