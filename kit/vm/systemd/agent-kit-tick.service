[Unit]
Description=Agent kit: every minute: a scheduled stop that is due, a one-shot job that lost its cycle or whose time has come, a cycle slot that is due

[Service]
Type=oneshot
# "-": a problem here must never keep the scheduled stop below from running.
ExecStart=-/opt/agent-kit/bin/agent-kit-oneshot reap
ExecStart=-/opt/agent-kit/bin/agent-kit-chat reap
ExecStart=/opt/agent-kit/bin/agent-kit-halt --if-due
# After the stop check, so that a slot never starts a cycle a due halt would cut at once.
ExecStart=-/opt/agent-kit/bin/agent-kit-schedule tick
# A one-shot job set for a time (kit 0.10): after the slots, so a slot due this same minute goes first.
ExecStart=-/opt/agent-kit/bin/agent-kit-oneshot due
