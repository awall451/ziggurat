[Unit]
Description=Agent kit: one chat turn of the lead (resumes a planning session)
After=network-online.target

[Service]
Type=oneshot
User=agent
WorkingDirectory=/home/agent
EnvironmentFile=/etc/agent-kit/agent.env
EnvironmentFile=-/etc/agent-kit/auth.env
ExecStart=/opt/agent-kit/bin/lead-chat
# Root, with an empty environment: agent.env puts a folder the agent can write first in PATH.
ExecStopPost=+/usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /opt/agent-kit/bin/agent-kit-chat finish
TimeoutStartSec=30min
TimeoutStopSec=30
Nice=5
MemoryMax=4G
