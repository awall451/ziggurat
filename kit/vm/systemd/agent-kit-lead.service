[Unit]
Description=Agent kit: one lead cycle
After=network-online.target

[Service]
Type=oneshot
User=agent
WorkingDirectory=/home/agent
EnvironmentFile=/etc/agent-kit/agent.env
# A subscription token, when one is stored (agent-kit-auth). Without the file
# the agent's own login is used.
EnvironmentFile=-/etc/agent-kit/auth.env
ExecStart=/opt/agent-kit/bin/lead-cycle
TimeoutStartSec=12h
# A halt stops the whole cycle; lead-cycle gets a minute to write its ledger line.
TimeoutStopSec=60
Nice=5
MemoryMax=10G
