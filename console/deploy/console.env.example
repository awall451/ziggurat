# Settings of a console that runs under systemd (console/deploy/). bootstrap.sh
# copies this to /srv/ziggurat/console.env on first run; edit it there.
HOST=0.0.0.0
PORT=8440
BODY_SIZE_LIMIT=26214400

# The checkout the console runs from, and the themes in it.
CONSOLE_REPO_DIR=/opt/ziggurat
ZIGGURAT_THEMES_DIR=/opt/ziggurat/themes

# projects.json, targets.json, pricing.json
CONSOLE_CONFIG_DIR=/srv/ziggurat/config
# threads, attachments, audit log
CONSOLE_DATA_DIR=/srv/ziggurat/console-data
# pulled ledger, gate history, notes, screenshots: one folder per project
FLEET_DATA=/srv/ziggurat/fleet
# pulled transcripts: one folder per project
TRANSCRIPTS_DIR=/srv/ziggurat/transcripts

# The private key the console uses, made by bootstrap.sh. For projects reached
# through an ssh alias, /srv/ziggurat/home/.ssh/config names the same file.
CONSOLE_SSH_KEY_FILE=/srv/ziggurat/ssh/key

# The address you open the console at, when a proxy in front changes it
# (comma separated origins, e.g. https://console.example.org).
CONSOLE_ALLOWED_ORIGINS=

# Set when an auth proxy in front adds the signed-in user's name as a header.
CONSOLE_USER_HEADER=

# 1 to allow deploy targets: the console's ssh key then logs in to your Proxmox
# host as an administrator (see README, "Deploy targets"). Leave empty otherwise.
CONSOLE_DEPLOY=
# With CONSOLE_DEPLOY=1: the folder that holds your planned projects.
CONSOLE_PROJECTS_DIR=/srv/ziggurat/projects
