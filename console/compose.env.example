# Copy outside the repository, fill in, and pass with --env-file.
CONSOLE_NAME=ziggurat
CONSOLE_PORT=8440

# projects.json, targets.json, pricing.json
CONSOLE_CONFIG_DIR=/srv/ziggurat/config
# threads, attachments, audit log
CONSOLE_DATA_DIR=/srv/ziggurat/console-data
# pulled ledger, gate history, notes, screenshots: one folder per project
FLEET_DATA=/srv/ziggurat/fleet
# pulled transcripts: one folder per project
TRANSCRIPTS_DIR=/srv/ziggurat/transcripts

# A folder holding `config` (Host entries for the gateway and each VM, with
# `IdentityFile /run/console/ssh_key`) and `known_hosts` for those hosts.
CONSOLE_SSH_DIR=/srv/ziggurat/ssh
# The private key the console uses. Readable by uid 1000, mode 600.
CONSOLE_SSH_KEY=/home/you/.ssh/id_ed25519

# Set when an auth proxy in front adds the signed-in user's name as a header.
CONSOLE_USER_HEADER=

# 1 to allow deploy targets: the console's ssh key then logs in to your Proxmox
# host as an administrator (see README, "Deploy targets"). Leave empty otherwise.
CONSOLE_DEPLOY=
# With CONSOLE_DEPLOY=1: the folder that holds your planned projects, one
# sub-folder each with team/ (and usually seed/). Mounted read-only.
CONSOLE_PROJECTS_DIR=
# Optional, with CONSOLE_DEPLOY=1: save a token from `claude setup-token` as
# CONSOLE_CONFIG_DIR/claude-token (one line, mode 600) and new VMs are signed in
# to Claude without a manual login. See README, "Creating a project".
