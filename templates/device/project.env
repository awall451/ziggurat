# Defaults for a project started from this template. The console writes the
# project's own names, models and brakes; only the lines below are taken over.
LEAD_MODEL=fable
FALLBACK_MODEL=opus
# The seed has one test (tests/seed.sh); the gate proof deletes it and must be refused.
BASELINE_TESTS=1
GATE_PROOF_DELETE=tests/seed.sh
# tools/check defines what "done" means: a change to it waits for the owner (kit 0.14).
GATE_OWNER_PATHS=tools/check,tools/check.d
