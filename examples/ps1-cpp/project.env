# /etc/agent-kit/project.env  (root-owned; sourced by kit scripts)
PROJECT=nocturne
WORKSPACE=/home/agent/nocturne
BARE=/srv/nocturne.git
STATE=/var/lib/agent-kit

LEAD_MODEL=fable
FALLBACK_MODEL=opus

# Runaway brakes (API-equivalent estimate per cycle; subscription limits still apply).
CYCLE_BUDGET_USD=40
MAX_CYCLES_PER_DAY=24
BASELINE_TESTS=114
