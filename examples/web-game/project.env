# /etc/agent-kit/project.env  (root-owned; sourced by kit scripts)
PROJECT=oakhollow
WORKSPACE=/home/agent/oakhollow
BARE=/srv/oakhollow.git
STATE=/var/lib/agent-kit

# Models: the lead on Fable; fallback when Fable is unavailable.
LEAD_MODEL=fable
FALLBACK_MODEL=opus

# Brakes. Cost is Claude Code's API-equivalent estimate, not a bill: it is a
# runaway guard per cycle. Subscription limits still apply on top.
CYCLE_BUDGET_USD=40
MAX_CYCLES_PER_DAY=24
