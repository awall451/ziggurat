# Ziggurat workstation config. Copy to ~/.config/ziggurat/config.env (or point
# ZIGGURAT_CONFIG at it). Keep the real file private: it names your machines.

# Admin user created in the gateway CT and agent VMs (sandbox/proxmox/vars).
ADMIN_USER=admin
# Private key whose public half you gave the playbooks (admin_ssh_pubkey).
SSH_KEY=$HOME/.ssh/id_ed25519

# Where pulled data lives (notes, screenshots, ledgers, digests, dashboard JSON).
FLEET_DATA=$HOME/ziggurat-data
# Optional: agent-boxes.conf location (default $FLEET_DATA/agent-boxes.conf).
#AGENT_BOXES_CONF=$FLEET_DATA/agent-boxes.conf

# Optional: the dashboard folder of this repo (enables publish + spoken brief).
#DASHBOARD_DIR=$HOME/ziggurat/dashboard
# Optional: a token tracker serving /api/project, and where it reads agent transcripts.
#TOKEN_TRACKER_URL=http://127.0.0.1:9420
#TRACKER_AGENT_BOXES=$HOME/.local/share/claude-token-tracker/agent-boxes
